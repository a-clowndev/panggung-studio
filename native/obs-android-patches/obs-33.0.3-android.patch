+static volatile long g_android_gpu_surface_encoders = 0;
+static volatile long g_android_total_raw_encoders = 0;
+
+EXPORT void obs_android_gpu_surface_encoder_delta(int delta)
+{
+	if (delta > 0)
+		os_atomic_inc_long(&g_android_gpu_surface_encoders);
+	else if (delta < 0)
+		os_atomic_dec_long(&g_android_gpu_surface_encoders);
+}
+
+void obs_android_raw_video_encoder_delta(int delta)
+{
+	if (delta > 0)
+		os_atomic_inc_long(&g_android_total_raw_encoders);
+	else if (delta < 0)
+		os_atomic_dec_long(&g_android_total_raw_encoders);
+}
+
+static inline bool android_skip_cpu_readback(void)
+{
+	long gpu = os_atomic_load_long(&g_android_gpu_surface_encoders);
+	long tot = os_atomic_load_long(&g_android_total_raw_encoders);
+	return gpu > 0 && tot > 0 && gpu >= tot;
+}
