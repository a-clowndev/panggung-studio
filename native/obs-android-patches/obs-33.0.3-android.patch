@@ -1099,10 +1103,27 @@ uint64_t os_get_free_disk_space(const char *dir)
 
 char *os_generate_uuid(void)
 {
-	uuid_t uuid;
 	// 36 char UUID + NULL
 	char *out = bmalloc(37);
+#ifdef __ANDROID__
+	uint8_t b[16] = {0};
+	if (getrandom(b, sizeof(b), 0) != (ssize_t)sizeof(b)) {
+		FILE *f = fopen("/dev/urandom", "rb");
+		if (f) {
+			(void)fread(b, 1, sizeof(b), f);
+			fclose(f);
+		}
+	}
+	b[6] = (uint8_t)((b[6] & 0x0F) | 0x40); /* version 4 */
+	b[8] = (uint8_t)((b[8] & 0x3F) | 0x80); /* variant 1 */
+	snprintf(out, 37,
+		 "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+		 b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+		 b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+#else
+	uuid_t uuid;
 	uuid_generate(uuid);
 	uuid_unparse_lower(uuid, out);
+#endif
 	return out;
 }
